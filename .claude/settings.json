{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(gh repo create *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo sync *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo fork *)",
      "Bash(gh release *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr ready *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh gist *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh label *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)",
      "Bash(gh pr lock *)",
      "Bash(gh pr unlock *)",
      "Bash(gh pr revert *)",
      "Bash(gh pr update-branch *)",
      "Bash(gh issue develop *)",
      "Bash(gh issue lock *)",
      "Bash(gh issue unlock *)",
      "Bash(gh issue pin *)",
      "Bash(gh issue unpin *)",
      "Bash(gh repo unarchive *)",
      "Bash(gh repo autolink *)",
      "Bash(gh repo deploy-key *)",
      "Bash(gh cache delete *)",
      "Bash(gh codespace *)",
      "Bash(gh project *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh alias *)",
      "Bash(gh extension *)",
      "Bash(gh agent-task create *)",
      "Bash(gh api *)",
      "Bash(uv publish *)",
      "Bash(twine upload *)",
      "PublishPlugin"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--frozen", "--directory", "${CLAUDE_PROJECT_DIR}", "python", "-m", "tools.hooks.push_guard"],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--frozen", "--directory", "${CLAUDE_PROJECT_DIR}", "python", "-m", "tools.hooks.ruff_after_edit"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--frozen", "--directory", "${CLAUDE_PROJECT_DIR}", "python", "-m", "tools.hooks.stop_checks"],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
