{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(gh repo create *)",
      "Bash(gh release *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue create *)",
      "Bash(gh api *)",
      "Bash(uv publish *)",
      "Bash(twine upload *)",
      "PublishPlugin"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--frozen", "--directory", "${CLAUDE_PROJECT_DIR}", "python", "-m", "tools.hooks.push_guard"],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--frozen", "--directory", "${CLAUDE_PROJECT_DIR}", "python", "-m", "tools.hooks.ruff_after_edit"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--frozen", "--directory", "${CLAUDE_PROJECT_DIR}", "python", "-m", "tools.hooks.stop_checks"],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
