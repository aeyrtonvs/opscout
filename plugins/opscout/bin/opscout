#!/usr/bin/env -S uv run --script --quiet
# SPDX-License-Identifier: Apache-2.0
# /// script
# requires-python = ">=3.13"
# dependencies = []
# ///
"""Run the opscout engine that matches this plugin (ADR-0022).

Claude Code puts this directory on the Bash tool's PATH in a session (not in an eval run),
so skills call it by its path, ``"${CLAUDE_PLUGIN_ROOT}/bin/opscout" ...``.
From a clone of the repository (``claude --plugin-dir <clone>/plugins/opscout``) this runs
the clone's code; an installed plugin runs the release of exactly its own version. The
launcher replaces itself with the engine, so arguments, streams and the exit status pass
through unchanged.
"""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

PLUGIN = Path(__file__).resolve().parents[1]
UNRELEASED = "0.0.0"
ENGINE_SECONDS = 8
"""How long the session checks' engine may take; the hook's own timeout is 10 s."""


def clone_root() -> Path | None:
    """Return the repository root when the plugin sits in a clone, else None."""
    root = PLUGIN.parents[1]
    pyproject = root / "pyproject.toml"
    in_clone = (root / "src" / "opscout").is_dir() and pyproject.is_file()
    if in_clone and 'name = "opscout"' in pyproject.read_text(encoding="utf-8"):
        return root
    return None


def _not_the_guards_business(event_text: str) -> bool:
    """Return True when a hook event surely holds no push and no pull request.

    The push guard runs before every Bash command, so the commands that cannot concern it
    are answered here, at once and without the engine. This is a superset check: anything
    that might be a push goes on to the engine, which decides.
    """
    try:
        event = json.loads(event_text)
        command = event["tool_input"]["command"] if event["tool_name"] == "Bash" else ""
    except (ValueError, KeyError, TypeError):
        return False
    if not isinstance(command, str):
        return False
    return "push" not in command and not ("gh" in command and "pr" in command)


def _session_checks_could_not_run(reason: str) -> None:
    """End the SessionStart hook with one message: a session start is never blocked."""
    message = f"opscout: the session checks could not run: {reason}"
    sys.stdout.write(json.dumps({"systemMessage": message}) + "\n")
    sys.exit(0)


def main() -> None:
    """Replace this process with the engine that matches the plugin."""
    arguments = sys.argv[1:]
    hook = arguments[:2] == ["hook", "pre-tool-use"]
    session_start = arguments[:2] == ["hook", "session-start"]
    event_text = sys.stdin.read() if hook or session_start else ""
    if hook and _not_the_guards_business(event_text):
        sys.exit(0)
    root = clone_root()
    if root is not None:
        command = [
            "uv",
            "run",
            "--quiet",
            "--frozen",
            "--extra",
            "aws",
            "--project",
            str(root),
            "opscout",
        ]
    else:
        manifest = PLUGIN / ".claude-plugin" / "plugin.json"
        version = json.loads(manifest.read_text(encoding="utf-8"))["version"]
        if version == UNRELEASED:
            if session_start:
                _session_checks_could_not_run(
                    "there is no release of this plugin to run; load the plugin from a clone "
                    "(claude --plugin-dir <clone>/plugins/opscout)"
                )
            if hook:
                sys.stderr.write(
                    "opscout push guard: there is no release of this plugin to run the guard, "
                    "so this push or pull request is refused; load the plugin from a clone "
                    "(claude --plugin-dir <clone>/plugins/opscout).\n"
                )
                sys.exit(2)
            sys.stderr.write(
                f"opscout: this plugin is version {UNRELEASED}, and there is no release of it "
                "to run. Until the first release, load the plugin from a clone:\n"
                "  git clone https://github.com/aeyrtonvs/opscout\n"
                "  claude --plugin-dir opscout/plugins/opscout\n"
            )
            sys.exit(1)
        command = ["uvx", "--quiet", "--from", f"opscout[aws]=={version}", "opscout"]
    program = shutil.which(command[0])
    if program is None and session_start:
        _session_checks_could_not_run(f"{command[0]} is required: https://docs.astral.sh/uv/")
    if program is None:
        sys.stderr.write(f"opscout: {command[0]} is required: https://docs.astral.sh/uv/\n")
        sys.exit(127)
    if hook:
        # The event was read above, so the engine gets it on its standard input; a failure
        # to start the engine blocks the command rather than letting it through.
        result = subprocess.run(  # noqa: S603  (a fixed program)
            [program, *command[1:], *arguments], input=event_text, text=True, check=False
        )
        sys.exit(result.returncode if result.returncode in (0, 2) else 2)
    if session_start:
        # The engine may need to be fetched or may fail; the session starts either way.
        try:
            result = subprocess.run(  # noqa: S603  (a fixed program)
                [program, *command[1:], *arguments],
                input=event_text,
                capture_output=True,
                text=True,
                check=False,
                timeout=ENGINE_SECONDS,
            )
        except subprocess.TimeoutExpired:
            _session_checks_could_not_run(f"the engine took longer than {ENGINE_SECONDS} s")
        if result.returncode != 0:
            _session_checks_could_not_run(f"the engine exited with status {result.returncode}")
        sys.stdout.write(result.stdout)
        sys.exit(0)
    os.execv(program, [program, *command[1:], *arguments])  # noqa: S606  (a fixed program)


if __name__ == "__main__":
    main()
