{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aeyrtonvs/opscout/main/schemas/config.schema.json",
  "$defs": {
    "ChatSetting": {
      "additionalProperties": false,
      "description": "Where deliveries go by direct message (spec 008).",
      "properties": {
        "service": {
          "const": "slack",
          "description": "The chat service; only slack.",
          "title": "Service",
          "type": "string"
        },
        "user": {
          "description": "Your Slack member id (in Slack: your profile, then Copy member ID).",
          "pattern": "^[UW][A-Z0-9]{2,20}$",
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "service",
        "user"
      ],
      "title": "ChatSetting",
      "type": "object"
    },
    "CodeHost": {
      "additionalProperties": false,
      "description": "Where the user's pull requests are (spec 009).",
      "properties": {
        "service": {
          "const": "bitbucket",
          "description": "The code host; only bitbucket.",
          "title": "Service",
          "type": "string"
        },
        "login": {
          "description": "The account the token belongs to: its e-mail or username.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Login",
          "type": "string"
        }
      },
      "required": [
        "service",
        "login"
      ],
      "title": "CodeHost",
      "type": "object"
    },
    "Daemon": {
      "additionalProperties": false,
      "dependentSchemas": {
        "chat": {
          "properties": {
            "secrets": {
              "required": [
                "slack_bot_token",
                "slack_app_token"
              ]
            }
          },
          "required": [
            "secrets"
          ]
        }
      },
      "description": "Scheduled jobs and what their runs need (specs 007 and 008).",
      "properties": {
        "jobs": {
          "additionalProperties": {
            "$ref": "#/$defs/JobSettings"
          },
          "description": "The jobs to schedule, by name; the engine defines them (now only check).",
          "maxProperties": 20,
          "propertyNames": {
            "enum": [
              "check",
              "standup"
            ]
          },
          "title": "Jobs",
          "type": "object"
        },
        "claude_path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 2,
              "pattern": "^/[^\\n]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The Claude Code executable, as an absolute path; without it, PATH.",
          "title": "Claude Path"
        },
        "secrets": {
          "additionalProperties": {
            "$ref": "#/$defs/KeychainRef"
          },
          "description": "The harness's own secrets, by name, each a keychain reference: claude_token, a token from claude setup-token for jobs that cannot use your login; slack_bot_token and slack_app_token, the chat app's tokens; bitbucket_token, a read-only Bitbucket API token for the standup.",
          "propertyNames": {
            "enum": [
              "claude_token",
              "slack_bot_token",
              "slack_app_token",
              "bitbucket_token"
            ]
          },
          "title": "Secrets",
          "type": "object"
        },
        "chat": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatSetting"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deliver by direct message, and record agreement (spec 008)."
        }
      },
      "title": "Daemon",
      "type": "object"
    },
    "JobSettings": {
      "additionalProperties": false,
      "description": "When a job runs and the limits of its model run (spec 007).",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether opscout daemon install schedules this job.",
          "title": "Enabled",
          "type": "boolean"
        },
        "at": {
          "description": "The time of day, HH:MM in the machine's local time; quote it (\"09:30\").",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "At",
          "type": "string"
        },
        "weekdays": {
          "description": "The days it runs, from mon to sun; without it, every day.",
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Weekdays",
          "type": "array",
          "uniqueItems": true
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^(haiku|sonnet|opus|fable|claude-[a-z0-9][a-z0-9.-]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The model: an alias (haiku, sonnet, opus, fable) or a full claude-… id.",
          "title": "Model"
        },
        "budget_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The most one run may cost, in US dollars.",
          "title": "Budget Usd"
        },
        "max_turns": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The most turns one run may take.",
          "title": "Max Turns"
        }
      },
      "required": [
        "at"
      ],
      "title": "JobSettings",
      "type": "object"
    },
    "KeychainRef": {
      "additionalProperties": false,
      "description": "A credential in the OS keychain, named by its service and account, never by its value.",
      "properties": {
        "service": {
          "description": "The keychain service under which the credential is stored.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Service",
          "type": "string"
        },
        "account": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The keychain account of the credential, when the service holds several.",
          "title": "Account"
        }
      },
      "required": [
        "service"
      ],
      "title": "KeychainRef",
      "type": "object"
    },
    "PersonalContext": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "language"
          ]
        },
        {
          "required": [
            "timezone"
          ]
        },
        {
          "required": [
            "sections"
          ]
        }
      ],
      "description": "Facts every Claude Code session should start with (spec 006).",
      "properties": {
        "language": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "pattern": "^[^\\n\\r\\x0b\\x0c\\x1c-\\x1e\\x85\\u2028\\u2029]*\\S[^\\n\\r\\x0b\\x0c\\x1c-\\x1e\\x85\\u2028\\u2029]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The language Claude answers you in.",
          "title": "Language"
        },
        "timezone": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Your time zone, as an IANA name such as Europe/Lisbon.",
          "title": "Timezone"
        },
        "sections": {
          "anyOf": [
            {
              "additionalProperties": false,
              "maxProperties": 20,
              "minProperties": 1,
              "patternProperties": {
                "^[^#\\s\\x1c-\\x1e][^\\n\\r\\x0b\\x0c\\x1c-\\x1e\\x85\\u2028\\u2029]*$": {
                  "items": {
                    "maxLength": 300,
                    "minLength": 1,
                    "pattern": "^[^\\n\\r\\x0b\\x0c\\x1c-\\x1e\\x85\\u2028\\u2029]*\\S[^\\n\\r\\x0b\\x0c\\x1c-\\x1e\\x85\\u2028\\u2029]*$",
                    "type": "string"
                  },
                  "maxItems": 50,
                  "minItems": 1,
                  "type": "array"
                }
              },
              "propertyNames": {
                "maxLength": 60,
                "minLength": 1,
                "pattern": "^[^#\\s\\x1c-\\x1e][^\\n\\r\\x0b\\x0c\\x1c-\\x1e\\x85\\u2028\\u2029]*$"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Headings, in order, each with the lines written under it.",
          "title": "Sections"
        }
      },
      "title": "PersonalContext",
      "type": "object"
    },
    "PullRequestConventions": {
      "additionalProperties": false,
      "description": "How the ship skill opens a pull request (spec 004).",
      "properties": {
        "base": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The branch the pull request targets; without it, the remote's default.",
          "title": "Base"
        },
        "draft": {
          "const": true,
          "default": true,
          "description": "Pull requests are always drafts for a person to finish.",
          "title": "Draft",
          "type": "boolean"
        }
      },
      "title": "PullRequestConventions",
      "type": "object"
    },
    "Ship": {
      "additionalProperties": false,
      "description": "Conventions for the ship skill and its push guard (spec 004).",
      "properties": {
        "protected_branches": {
          "description": "Branch name patterns (globs such as release/*) that are never pushed to. main, master and the remote's default branch are protected whatever this says.",
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Protected Branches",
          "type": "array"
        },
        "branch_pattern": {
          "default": "{type}/{slug}",
          "description": "How new branches are named, with the tokens {type}, {slug} and {ticket}.",
          "maxLength": 100,
          "title": "Branch Pattern",
          "type": "string"
        },
        "types": {
          "description": "The Conventional Commit types allowed in commit messages and branch names.",
          "items": {
            "pattern": "^[a-z]{1,20}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Types",
          "type": "array"
        },
        "trailer": {
          "default": "Assisted-by: Claude Code",
          "description": "The trailer that ends every commit message the skill writes.",
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z-]*: [^\\n]*\\S$",
          "title": "Trailer",
          "type": "string"
        },
        "pull_request": {
          "$ref": "#/$defs/PullRequestConventions",
          "description": "How pull requests are opened."
        }
      },
      "title": "Ship",
      "type": "object"
    },
    "Sso": {
      "additionalProperties": false,
      "description": "Which SSO logins the session-start check looks at (spec 005).",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether the check runs when a Claude Code session starts.",
          "title": "Enabled",
          "type": "boolean"
        },
        "sessions": {
          "anyOf": [
            {
              "items": {
                "maxLength": 100,
                "minLength": 1,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
                "type": "string"
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The SSO sessions or older SSO profiles to check, by name; without it, every one in the AWS config.",
          "title": "Sessions"
        }
      },
      "title": "Sso",
      "type": "object"
    },
    "Standup": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "folders": {
              "minItems": 1
            }
          },
          "required": [
            "folders"
          ]
        },
        {
          "properties": {
            "projects": {
              "minProperties": 1
            }
          },
          "required": [
            "projects"
          ]
        }
      ],
      "description": "The daily standup's sources and projects (spec 009).",
      "properties": {
        "identities": {
          "description": "Your commit identities: author e-mails or names.",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\n\\r\\x0b\\x0c\\x1c-\\x1e\\x85\\u2028\\u2029]*\\S[^\\n\\r\\x0b\\x0c\\x1c-\\x1e\\x85\\u2028\\u2029]*$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Identities",
          "type": "array"
        },
        "code_host": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeHost"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where your pull requests are; without it, none are read."
        },
        "folders": {
          "description": "Folders whose git repositories are your projects, each named after its directory, with its Bitbucket repository from its origin remote.",
          "items": {
            "maxLength": 1024,
            "minLength": 2,
            "pattern": "^/[^\\n]*$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Folders",
          "type": "array"
        },
        "projects": {
          "additionalProperties": false,
          "description": "Projects listed by hand, to group repositories or adjust one found in a folder.",
          "maxProperties": 30,
          "patternProperties": {
            "^[a-z][a-z0-9]*(-[a-z0-9]+)*$": {
              "$ref": "#/$defs/StandupProject"
            }
          },
          "propertyNames": {
            "maxLength": 40
          },
          "title": "Projects",
          "type": "object"
        },
        "redact": {
          "description": "Terms never sent to the model, whatever their case: names, codes.",
          "items": {
            "maxLength": 100,
            "minLength": 2,
            "pattern": "^[^\\n\\r\\x0b\\x0c\\x1c-\\x1e\\x85\\u2028\\u2029]*\\S[^\\n\\r\\x0b\\x0c\\x1c-\\x1e\\x85\\u2028\\u2029]*$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Redact",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/StandupLimits",
          "description": "How much of each source is kept."
        }
      },
      "required": [
        "identities"
      ],
      "title": "Standup",
      "type": "object"
    },
    "StandupLimits": {
      "additionalProperties": false,
      "description": "How much of each source the standup keeps (research R5).",
      "properties": {
        "prompt_length": {
          "default": 300,
          "description": "The longest a prompt is kept, in characters.",
          "maximum": 1000,
          "minimum": 80,
          "title": "Prompt Length",
          "type": "integer"
        },
        "prompts_per_session": {
          "default": 20,
          "description": "The most prompts kept per session (first and last halves).",
          "maximum": 100,
          "minimum": 2,
          "title": "Prompts Per Session",
          "type": "integer"
        },
        "prompts": {
          "default": 60,
          "description": "The most prompts kept in all.",
          "maximum": 300,
          "minimum": 10,
          "title": "Prompts",
          "type": "integer"
        },
        "commits": {
          "default": 40,
          "description": "The most commits kept.",
          "maximum": 200,
          "minimum": 10,
          "title": "Commits",
          "type": "integer"
        },
        "pull_requests": {
          "default": 30,
          "description": "The most pull request facts kept.",
          "maximum": 100,
          "minimum": 5,
          "title": "Pull Requests",
          "type": "integer"
        }
      },
      "title": "StandupLimits",
      "type": "object"
    },
    "StandupProject": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "paths": {
              "minItems": 1
            }
          },
          "required": [
            "paths"
          ]
        },
        {
          "properties": {
            "repositories": {
              "minItems": 1
            }
          },
          "required": [
            "repositories"
          ]
        }
      ],
      "description": "A project the standup groups by: its local clones and code-host repositories.",
      "properties": {
        "paths": {
          "description": "Absolute paths of the local clones; sessions in them belong here.",
          "items": {
            "maxLength": 1024,
            "minLength": 2,
            "pattern": "^/[^\\n]*$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Paths",
          "type": "array"
        },
        "repositories": {
          "description": "Code-host repositories, as workspace/slug.",
          "items": {
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Repositories",
          "type": "array"
        }
      },
      "title": "StandupProject",
      "type": "object"
    },
    "WriteupFormat": {
      "additionalProperties": false,
      "description": "A shape for a write-up: its sections in order, its rules and its length (spec 003).",
      "properties": {
        "description": {
          "description": "What this format is for, in one line.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\n]*$",
          "title": "Description",
          "type": "string"
        },
        "sections": {
          "description": "The headings of the write-up, in order; none for free text.",
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[^\\n]*$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Sections",
          "type": "array"
        },
        "rules": {
          "description": "Rules for this format only.",
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[^\\n]*$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Rules",
          "type": "array"
        },
        "max_lines": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The most lines a write-up in this format may have.",
          "title": "Max Lines"
        }
      },
      "required": [
        "description"
      ],
      "title": "WriteupFormat",
      "type": "object"
    },
    "Writeups": {
      "additionalProperties": false,
      "description": "Write-up formats for the summary skill; built-in formats apply without them (spec 003).",
      "properties": {
        "language": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "pattern": "^[^\\n]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The language to write in; without it, the language the user writes in.",
          "title": "Language"
        },
        "rules": {
          "description": "Rules for every format.",
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[^\\n]*$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Rules",
          "type": "array"
        },
        "formats": {
          "additionalProperties": false,
          "description": "Formats by name. A name of a built-in format (ticket, message, postmortem) replaces it; a new name adds a format.",
          "patternProperties": {
            "^[a-z][a-z0-9]*(-[a-z0-9]+)*$": {
              "$ref": "#/$defs/WriteupFormat"
            }
          },
          "propertyNames": {
            "maxLength": 40
          },
          "title": "Formats",
          "type": "object"
        }
      },
      "title": "Writeups",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The private opscout configuration (config.yaml in the configuration directory).",
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "The major version of the configuration schema this file follows. This engine reads version 1.",
      "title": "Schema Version",
      "type": "integer"
    },
    "writeups": {
      "$ref": "#/$defs/Writeups",
      "description": "Write-up formats for the summary skill (spec 003)."
    },
    "ship": {
      "$ref": "#/$defs/Ship",
      "description": "Branch, commit and pull request conventions, and the protected branches."
    },
    "sso": {
      "$ref": "#/$defs/Sso",
      "description": "The SSO check at the start of a Claude Code session (spec 005)."
    },
    "personal_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/PersonalContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The facts opscout context apply writes into your Claude Code CLAUDE.md (spec 006)."
    },
    "daemon": {
      "$ref": "#/$defs/Daemon",
      "description": "Scheduled jobs, the Claude Code executable and the harness's secrets (spec 007)."
    },
    "standup": {
      "anyOf": [
        {
          "$ref": "#/$defs/Standup"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The daily standup's sources and projects (spec 009)."
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "opscout configuration",
  "type": "object"
}
